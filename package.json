{
  "name": "imasport",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "sandbox": "ampx sandbox --identifier imasportdev",
    "sandbox:once": "ampx sandbox --once --identifier imasportdev",
    "sandbox:delete": "ampx sandbox delete --identifier imasportdev",
    "seed": "tsx scripts/seed.ts",
    "test:auth": "tsx scripts/smoke-test.ts",
    "test:e2e": "tsx scripts/e2e-test.ts && tsx scripts/e2e-coach-flow.ts && tsx scripts/e2e-upload.ts && tsx scripts/prune-orphans.ts --delete",
    "test": "npm run typecheck && npm run test:auth",
    "prune:orphans": "tsx scripts/prune-orphans.ts",
    "test:coach": "tsx scripts/e2e-coach-flow.ts",
    "test:upload": "tsx scripts/e2e-upload.ts"
  },
  "dependencies": {
    "@aws-amplify/adapter-nextjs": "^1.8.1",
    "@aws-amplify/ui-react": "^6.15.7",
    "aws-amplify": "^6.22.2",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "next-intl": "^4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1159.0",
    "@tailwindcss/postcss": "^4",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "puppeteer": "^25.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "tsx": "^4.23.15"
  },
  "allowScripts": {
    "puppeteer@25.9.0": true
  }
}
